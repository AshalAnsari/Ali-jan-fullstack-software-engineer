# Canonical origin used for metadata, sitemap, robots, Open Graph and JSON-LD.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Google Search Console verification token (the content="..." value
# from the "HTML tag" method). Renders <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
